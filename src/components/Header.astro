---
const navLinks = [
  { href: '#ecosystem', label: 'Ecosistema' },
  { href: '#terminal', label: 'Terminal' },
  { href: '#projects', label: 'Proyectos' },
  { href: '#flagships', label: 'Flagships' },
  { href: '#roadmap', label: 'Roadmap' },
  { href: '#manifesto', label: 'Manifiesto' },
];
---

<header class="header" id="siteHeader">
  <div class="container header-inner">
    <a href="#ecosystem" class="brand" aria-label="UNIVERS42 — Ir al inicio">
      <div class="brand-icon">
        <span>42</span>
      </div>
      <div class="brand-text">
        <span class="brand-name">UNIVERS42</span>
        <span class="brand-sub">Open Source Ecosystem</span>
      </div>
    </a>

    <nav class="nav" id="mainNav" aria-label="Navegación principal">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button id="audioToggle" class="btn-audio" title="Alternar sintetizador sonoro" aria-label="Efectos de sonido" aria-pressed="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
      </button>

      <a href="https://github.com/Univers42" target="_blank" rel="noopener noreferrer" class="btn-github" aria-label="Ver en GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>GitHub</span>
      </a>
      <button class="mobile-toggle" id="mobileToggle" aria-label="Abrir menú" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  background: rgba(3, 6, 14, 0.8);
  border-bottom: 1px solid var(--border-subtle);
  transition: var(--transition);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
}

/* Brand */
.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: linear-gradient(135deg, #0a1832, #131f44);
  border: 1px solid var(--border-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20px rgba(0, 212, 255, 0.15);
  transition: var(--transition);
}

.brand:hover .brand-icon {
  transform: scale(1.06);
  box-shadow: 0 0 28px rgba(0, 212, 255, 0.3);
}

.brand-icon span {
  font-family: var(--font-mono);
  font-size: 1.1rem;
  font-weight: 800;
  background: linear-gradient(135deg, var(--cyan), var(--indigo));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.brand-name {
  font-weight: 800;
  font-size: 1.15rem;
  letter-spacing: -0.5px;
  color: var(--text-white);
}

.brand-sub {
  font-size: 0.7rem;
  color: var(--text-muted);
  letter-spacing: 0.3px;
}

.brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.3;
}

/* Nav */
.nav {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav-link {
  color: var(--text-secondary);
  font-size: 0.88rem;
  font-weight: 500;
  transition: var(--transition);
  position: relative;
  padding: 4px 0;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0%;
  height: 2px;
  background: linear-gradient(90deg, var(--cyan), var(--indigo));
  border-radius: 1px;
  transition: width 0.3s var(--ease-out);
}

.nav-link:hover {
  color: var(--text-white);
}

.nav-link:hover::after {
  width: 100%;
}

/* Actions */
.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-audio {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-light);
  color: var(--text-secondary);
  cursor: pointer;
  transition: var(--transition);
}

.btn-audio:hover {
  background: rgba(0, 212, 255, 0.08);
  border-color: var(--cyan);
  color: var(--cyan);
}

.btn-audio.active {
  background: rgba(0, 212, 255, 0.15);
  border-color: var(--cyan);
  color: var(--cyan);
  box-shadow: 0 0 15px rgba(0, 212, 255, 0.25);
}

.btn-github {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-light);
  padding: 8px 16px;
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: 0.85rem;
  font-weight: 600;
  transition: var(--transition);
}

.btn-github:hover {
  border-color: var(--cyan);
  background: var(--cyan-subtle);
  box-shadow: 0 0 20px rgba(0, 212, 255, 0.15);
  transform: translateY(-1px);
}

.btn-github svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

/* Mobile toggle */
.mobile-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: 1px solid var(--border-light);
  border-radius: var(--radius-sm);
  padding: 8px;
  width: 38px;
  height: 38px;
  justify-content: center;
  align-items: center;
}

.mobile-toggle span {
  width: 18px;
  height: 2px;
  background: var(--text-primary);
  border-radius: 2px;
  transition: var(--transition);
}

.mobile-toggle.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
.mobile-toggle.active span:nth-child(2) { opacity: 0; }
.mobile-toggle.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

@media (max-width: 768px) {
  .nav {
    display: none;
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    background: rgba(3, 6, 14, 0.97);
    backdrop-filter: blur(24px);
    flex-direction: column;
    padding: 1.5rem;
    gap: 0;
    border-bottom: 1px solid var(--border-accent);
    z-index: 999;
  }

  .nav.open {
    display: flex;
  }

  .nav-link {
    width: 100%;
    padding: 0.85rem 1rem;
    font-size: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-toggle {
    display: flex;
  }

  .btn-github span {
    display: none;
  }

  .btn-github {
    padding: 8px 10px;
  }

  .brand-sub {
    display: none;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const toggle = document.getElementById('mobileToggle');
  const nav = document.getElementById('mainNav');
  if (!toggle || !nav) return;

  toggle.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('open');
    toggle.classList.toggle('active');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle.classList.remove('active');
      toggle.setAttribute('aria-expanded', 'false');
    });
  });
});
</script>
