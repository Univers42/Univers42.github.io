---
---

<section class="manifesto-section" id="manifesto">
  <div class="container">
    <div class="manifesto-card fade-in">
      <div class="manifesto-glow" aria-hidden="true"></div>

      <span class="manifesto-badge">// EL CREDO DEL BUILDER DE UNIVERS42</span>

      <blockquote class="manifesto-quote">
        “The tools are the projects.<br />
        <span class="gradient-text">The projects are the tools.”</span>
      </blockquote>

      <p class="manifesto-text">
        Univers42 nació para no conformarse con terminar los proyectos obligatorios del cursus de Escuela 42. 
        Diseñamos los sanitizadores, shells, engines y suites de examen que aceleran la excelencia técnica de cualquier builder en la red 42. 
        Sin librerías mágicas, sin memory leaks y con código 100% público y libre.
      </p>

      <!-- 3 Core Pillars -->
      <div class="pillars-grid">
        <div class="pillar">
          <div class="pillar-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h4 class="pillar-title">Peer-to-Peer & FOSS</h4>
          <p class="pillar-desc">100% código abierto bajo licencias permisivas. Sin muros de pago ni dependencias propietarias.</p>
        </div>

        <div class="pillar">
          <div class="pillar-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h4 class="pillar-title">Zero Memory Leaks</h4>
          <p class="pillar-desc">Verificado con Valgrind, AddressSanitizer y rastreo determinista bloque a bloque.</p>
        </div>

        <div class="pillar">
          <div class="pillar-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <h4 class="pillar-title">Built From Scratch</h4>
          <p class="pillar-desc">Entendemos la máquina desde el byte: desde ASTs y forks en C hasta cifrado en Rust y WASM.</p>
        </div>
      </div>

      <div class="manifesto-actions">
        <a href="https://github.com/Univers42" target="_blank" rel="noopener noreferrer" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>Únete al Colectivo en GitHub</span>
        </a>
        <button id="manifestoTermBtn" class="btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          <span>Leer en Terminal Shell</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
.manifesto-section {
  padding: 6rem 0;
  position: relative;
  background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
}

.manifesto-card {
  position: relative;
  background: rgba(11, 18, 38, 0.7);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-2xl);
  padding: 4.5rem 3rem;
  text-align: center;
  backdrop-filter: blur(20px);
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
}

.manifesto-glow {
  position: absolute;
  top: -50%;
  left: 50%;
  transform: translateX(-50%);
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.12) 0%, rgba(99, 102, 241, 0.08) 50%, transparent 70%);
  pointer-events: none;
}

.manifesto-badge {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--cyan);
  font-family: var(--font-mono);
  margin-bottom: 1.5rem;
}

.manifesto-quote {
  font-size: clamp(2rem, 4vw, 3.25rem);
  font-weight: 900;
  line-height: 1.15;
  color: var(--text-white);
  letter-spacing: -0.02em;
  margin-bottom: 1.5rem;
}

.gradient-text {
  background: linear-gradient(135deg, var(--cyan) 0%, #a855f7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.manifesto-text {
  font-size: 1.1rem;
  line-height: 1.7;
  color: var(--text-secondary);
  max-width: 720px;
  margin: 0 auto 3.5rem auto;
}

/* 3 Pillars */
.pillars-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-bottom: 3.5rem;
  text-align: left;
}

.pillar {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 1.75rem;
  transition: var(--transition);
}

.pillar:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(0, 212, 255, 0.3);
  transform: translateY(-2px);
}

.pillar-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background: rgba(0, 212, 255, 0.1);
  border: 1px solid rgba(0, 212, 255, 0.2);
  color: var(--cyan);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.25rem;
}

.pillar-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 0.5rem;
}

.pillar-desc {
  font-size: 0.85rem;
  line-height: 1.5;
  color: var(--text-secondary);
}

.manifesto-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

@media (max-width: 860px) {
  .pillars-grid {
    grid-template-columns: 1fr;
  }
  .manifesto-card {
    padding: 3rem 1.5rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const manifestoTermBtn = document.getElementById('manifestoTermBtn');
  if (manifestoTermBtn) {
    manifestoTermBtn.addEventListener('click', () => {
      const term = document.getElementById('terminal');
      if (term) {
        term.scrollIntoView({ behavior: 'smooth' });
        setTimeout(() => {
          if ((window as any).runTermCommand) {
            (window as any).runTermCommand('manifesto');
          }
        }, 500);
      }
    });
  }
});
</script>
