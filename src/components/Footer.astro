      </div>

      <!-- Links Col 1 -->
      <div class="footer-col">
        <h4 class="col-title">Proyectos Destacados</h4>
        <ul class="col-links">
          <li><a href="https://github.com/Univers42/hellish" target="_blank" rel="noopener noreferrer">hellish (POSIX Shell)</a></li>
          <li><a href="https://github.com/Univers42/Torturette" target="_blank" rel="noopener noreferrer">Torturette (Heap Tracer)</a></li>
          <li><a href="https://github.com/Univers42/codewar" target="_blank" rel="noopener noreferrer">codewar (Assessment Simulator)</a></li>
          <li><a href="https://github.com/Univers42/42ctl" target="_blank" rel="noopener noreferrer">42ctl & vault42</a></li>
          <li><a href="https://github.com/Univers42/graph_render" target="_blank" rel="noopener noreferrer">graph_render (Rust & WASM)</a></li>
        </ul>
      </div>

      <!-- Links Col 2 -->
      <div class="footer-col">
        <h4 class="col-title">42 Testers & Utils</h4>
        <ul class="col-links">
          <li><a href="https://github.com/Univers42/francinette-installer" target="_blank" rel="noopener noreferrer">francinette-installer</a></li>
          <li><a href="https://github.com/Univers42/Examen42" target="_blank" rel="noopener noreferrer">Examen42</a></li>
          <li><a href="https://github.com/Univers42/born2root" target="_blank" rel="noopener noreferrer">born2root (Hypervisor)</a></li>
          <li><a href="https://github.com/Univers42/invisibility-cloak" target="_blank" rel="noopener noreferrer">invisibility-cloak (Tor)</a></li>
          <li><a href="https://github.com/Univers42/xft" target="_blank" rel="noopener noreferrer">xft (Extended Libft)</a></li>
        </ul>
      </div>

      <!-- Links Col 3 -->
      <div class="footer-col">
        <h4 class="col-title">Comunidad & Recursos</h4>
        <ul class="col-links">
          <li><a href="https://github.com/Univers42" target="_blank" rel="noopener noreferrer">Organización GitHub</a></li>
          <li><a href="https://github.com/Univers42/homebrew-tap" target="_blank" rel="noopener noreferrer">Homebrew Tap Oficial</a></li>
          <li><a href="https://github.com/Univers42/claude-deal-with-the-devil" target="_blank" rel="noopener noreferrer">Claude Agentic Skills</a></li>
          <li><a href="mailto:dev.pro.photo@gmail.com">Contacto de Mantenimiento</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="bottom-left">
        <span>© {currentYear} <strong>UNIVERS42</strong>. Código abierto bajo licencias MIT / GPL / Unlicense.</span>
        <span class="disclaimer">Hecho por 42 Cadets. No afiliado oficialmente a 42 Network.</span>
      </div>

      <button id="backToTop" class="back-to-top" aria-label="Volver arriba">
        <span>Subir</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--bg-surface);
  border-top: 1px solid var(--border-subtle);
  padding: 5rem 0 2.5rem 0;
  position: relative;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.8fr 1fr 1fr 1fr;
  gap: 3rem;
  margin-bottom: 4rem;
}

.footer-brand {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: linear-gradient(135deg, #0a1832, #131f44);
  border: 1px solid var(--border-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cyan);
  font-weight: 800;
  font-size: 1.1rem;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--text-white);
}

.brand-sub {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.brand-desc {
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--text-secondary);
  max-width: 360px;
}

.social-links {
  display: flex;
  gap: 10px;
}

.social-icon {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: var(--transition);
}

.social-icon:hover {
  background: rgba(0, 212, 255, 0.1);
  color: var(--cyan);
  border-color: rgba(0, 212, 255, 0.3);
  transform: translateY(-2px);
}

/* Columns */
.col-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 1.25rem;
}

.col-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.col-links a {
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 0.9rem;
  transition: var(--transition);
}

.col-links a:hover {
  color: var(--cyan);
  padding-left: 4px;
}

/* Footer Bottom */
.footer-bottom {
  padding-top: 2rem;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.5rem;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.bottom-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.disclaimer {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.back-to-top {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0.5rem 1rem;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
}

.back-to-top:hover {
  background: rgba(0, 212, 255, 0.1);
  color: var(--cyan);
  border-color: rgba(0, 212, 255, 0.3);
}

@media (max-width: 960px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
}

@media (max-width: 600px) {
  .footer-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const backToTop = document.getElementById('backToTop');
  if (backToTop) {
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
});
</script>
