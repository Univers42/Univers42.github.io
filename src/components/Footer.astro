---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="#ecosystem" class="brand" aria-label="UNIVERS42 — Ir al inicio">
          <div class="brand-icon">
            <span>42</span>
          </div>
          <div class="brand-text">
            <span class="brand-name">UNIVERS42</span>
