---
const stats = [
  { value: '192+', label: 'Repositorios Públicos' },
  { value: '100%', label: 'Peer-to-Peer & FOSS' },
  { value: '0', label: 'Memory Leaks Tolerados' },
  { value: 'R00→R06', label: 'Cobertura del Cursus' },
];

const trustLogos = [
  { name: 'C', color: '#555555' },
  { name: 'Rust', color: '#dea584' },
  { name: 'Shell', color: '#89e051' },
  { name: 'Python', color: '#3572A5' },
  { name: 'TypeScript', color: '#3178c6' },
  { name: 'C++', color: '#f34b7d' },
  { name: 'Assembly', color: '#6E4C13' },
  { name: 'WASM', color: '#654ff0' },
];
---

<section class="hero" id="ecosystem">
  <!-- Ambient gradient orbs -->
  <div class="hero-bg" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="grid-lines"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-badge fade-in">
      <span class="badge-dot"></span>
      <span>CLUSTER 42 // 192+ REPOS • 0 MEMORY LEAKS</span>
    </div>

    <h1 class="hero-title fade-in">
      The tools are the projects.<br />
      <span class="gradient-text">The projects are the tools.</span>
    </h1>

    <p class="hero-desc fade-in">
      <strong>Univers42</strong> es el laboratorio de software e ingeniería de sistemas forjado por la comunidad de <strong>Escuela 42</strong>. 
      Creamos shells POSIX con TDD, sanitizadores de memoria, simuladores de exámenes, 
      seguridad criptográfica y motores en Rust compilados a WebAssembly.
    </p>

    <div class="hero-actions fade-in">
      <a href="#projects" class="btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
        Explorar 192+ Repositorios
      </a>
      <a href="#terminal" class="btn-outline">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
        Abrir Terminal Shell
      </a>
    </div>

    <!-- Stats grid like Titan's trust section -->
    <div class="stats-grid fade-in stagger">
      {stats.map((stat, i) => (
        <div class="stat-card" style={`--i: ${i}`}>
          <div class="stat-value">{stat.value}</div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Trust bar / Tech marquee like Titan's partner logos -->
    <div class="trust-bar fade-in">
      <p class="trust-title">Construido con las tecnologías que importan</p>
      <div class="marquee-track">
        <div class="marquee-inner">
          {[...trustLogos, ...trustLogos].map(logo => (
            <span class="tech-badge">
              <span class="tech-dot" style={`background: ${logo.color}`}></span>
              {logo.name}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  padding: 6rem 0 4rem;
  overflow: hidden;
  min-height: 100vh;
  display: flex;
  align-items: center;
}

/* Ambient gradient background like Titan */
.hero-bg {
  transform: translate3d(0, var(--parallax-y, 0), 0);
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.orb {
  transform: translate3d(0, var(--parallax-y, 0), 0);
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.5;
}

.orb-1 {
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.15), transparent 70%);
  top: -20%;
  left: 20%;
  animation: float 20s infinite ease-in-out;
}

.orb-2 {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.12), transparent 70%);
  bottom: -10%;
  right: 10%;
  animation: float 25s infinite ease-in-out reverse;
}

.orb-3 {
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(168, 85, 247, 0.08), transparent 70%);
  top: 40%;
  left: -10%;
  animation: float 18s infinite ease-in-out 3s;
}

.grid-lines {
  transform: translate3d(0, var(--parallax-y, 0), 0);
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, rgba(255,255,255,0.02) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 90%);
  -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 90%);
}

@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30px, -20px) scale(1.05); }
  66% { transform: translate(-20px, 15px) scale(0.95); }
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Badge */
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 6px 18px;
  border-radius: var(--radius-full);
  background: rgba(0, 212, 255, 0.06);
  border: 1px solid rgba(0, 212, 255, 0.15);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--cyan);
  letter-spacing: 0.5px;
  margin-bottom: 2rem;
}

.badge-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--emerald);
  box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
  animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}

/* Title */
.hero-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: var(--text-white);
  max-width: 900px;
  margin-bottom: 1.5rem;
}

.gradient-text {
  background: linear-gradient(135deg, #ffffff 0%, var(--cyan) 50%, var(--indigo) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Description */
.hero-desc {
  font-size: clamp(1rem, 1.8vw, 1.15rem);
  color: var(--text-secondary);
  max-width: 680px;
  line-height: 1.75;
  margin-bottom: 2.5rem;
}

.hero-desc strong {
  color: var(--text-white);
  font-weight: 600;
}

/* Actions */
.hero-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 4rem;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, var(--cyan), #2563eb);
  color: #03060f;
  font-weight: 700;
  font-size: 0.95rem;
  padding: 14px 28px;
  border-radius: var(--radius-md);
  border: none;
  box-shadow: 0 8px 30px -6px rgba(0, 212, 255, 0.4);
  transition: var(--transition);
  text-decoration: none;
}

.btn-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 40px -4px rgba(0, 212, 255, 0.5);
  filter: brightness(1.08);
}

.btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10px);
  color: var(--text-white);
  font-weight: 600;
  font-size: 0.95rem;
  padding: 14px 28px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-light);
  transition: var(--transition);
  text-decoration: none;
}

.btn-outline:hover {
  background: rgba(0, 212, 255, 0.06);
  border-color: var(--cyan);
  color: var(--cyan);
  transform: translateY(-3px);
}

/* Stats Grid — Titan-inspired metrics strip */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  width: 100%;
  max-width: 920px;
  background: var(--border-subtle);
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: 4rem;
}

.stat-card {
  background: var(--bg-secondary);
  padding: 2rem 1.25rem;
  text-align: center;
  transition: var(--transition);
}

.stat-card:hover {
  background: var(--bg-surface);
}

.stat-value {
  font-family: var(--font-mono);
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--cyan);
  margin-bottom: 4px;
}

.stat-label {
  font-size: 0.8rem;
  color: var(--text-muted);
  font-weight: 500;
}

/* Trust bar / Marquee — Titan-inspired partner strip */
.trust-bar {
  width: 100%;
  max-width: 920px;
}

.trust-title {
  text-align: center;
  font-size: 0.82rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-weight: 600;
  margin-bottom: 1.5rem;
}

.marquee-track {
  overflow: hidden;
  mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
}

.marquee-inner {
  display: flex;
  gap: 2rem;
  animation: marquee 25s linear infinite;
  width: max-content;
}

.tech-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--text-secondary);
  font-weight: 500;
  white-space: nowrap;
  padding: 8px 16px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-subtle);
}

.tech-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ---- RESPONSIVE ---- */
@media (max-width: 768px) {
  .hero {
    padding: 4rem 0 2.5rem;
    min-height: auto;
  }

  .hero-actions {
    flex-direction: column;
    width: 100%;
    margin-bottom: 2.5rem;
  }

  .btn-primary, .btn-outline {
    width: 100%;
    justify-content: center;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: 2.5rem;
  }

  .stat-card {
    padding: 1.5rem 1rem;
  }

  .stat-value {
    font-size: 1.4rem;
  }
}

@media (max-width: 480px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }
}
</style>
